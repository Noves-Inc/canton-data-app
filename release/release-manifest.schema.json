{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["chart", "images"],
  "properties": {
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^4\\.[0-9]+\\.[0-9]+$"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "frontend", "database"],
      "properties": {
        "backend": {
          "$ref": "#/$defs/image"
        },
        "frontend": {
          "$ref": "#/$defs/image"
        },
        "database": {
          "$ref": "#/$defs/image"
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "source"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^ghcr\\.io/noves-inc/noves-canton-[a-z]+-v4$"
        },
        "tag": {
          "type": "string",
          "pattern": "^4\\.[0-9]+\\.[0-9]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    }
  }
}
