# Optional S3-compatible export storage. Leave the file absent to use the
# mounted /exports volume only.
EXPORTS_S3_BUCKET=
EXPORTS_S3_ENDPOINT_URL=
EXPORTS_S3_ACCESS_KEY_ID=
EXPORTS_S3_SECRET_ACCESS_KEY=
EXPORTS_S3_SESSION_TOKEN=
EXPORTS_S3_REGION=

# Optional S3-compatible transaction-history backups.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_SESSION_TOKEN=
BACKUP_S3_REGION=
