# Use the three pinned image references from the same v4 release.
BACKEND_IMAGE=ghcr.io/noves-inc/noves-canton-backend-v4:4.2.1@sha256:d80459a4701792d12877974f96f2042e0331a8540476be70bd53fb41bb010203
FRONTEND_IMAGE=ghcr.io/noves-inc/noves-canton-frontend-v4:4.2.1@sha256:bfb59186d80c36ae84e2640b2c8c1522319c8722411a27eb077bb99911b3dea9
DATABASE_IMAGE=ghcr.io/noves-inc/noves-canton-database-v4:4.2.1@sha256:a2edd1e0f22457f920e2143db1ea38ff62c5e70af537b5b86d481fbb23789436
DATABASE_PASSWORD=replace-with-a-long-random-password
APP_URL=https://data.example.com

# Default Canton Docker Compose conventions.
CANTON_DOCKER_NETWORK=splice-validator_splice_validator
CANTON_SCAN_API_URL=http://validator:5003/api/validator
# For a local Canton network only; see docs/environment-variables.md.
CANTON_LOCALNET_IDENTITIES=[]

# Auth0 browser client (leave blank when using Keycloak).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Keycloak browser client (leave blank when using Auth0).
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=
