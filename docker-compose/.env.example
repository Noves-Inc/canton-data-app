# Use the three pinned image references from the same v4 release.
BACKEND_IMAGE=ghcr.io/noves-inc/noves-canton-backend-v4:4.2.11@sha256:8ade6606db91ee1d1eaaa068cac9dc6d72a8e38e9a583bccd15897fd5f71d58e
FRONTEND_IMAGE=ghcr.io/noves-inc/noves-canton-frontend-v4:4.2.11@sha256:1e34cce759cad98ac84726283299192dac35c9ab417bb3dc0c73c9b3c656a7c7
DATABASE_IMAGE=ghcr.io/noves-inc/noves-canton-database-v4:4.2.11@sha256:a5d234cc926246937aa1402a08599d0ee4719601aa30edbf7b828bd3cc3a3bb5
DATABASE_PASSWORD=replace-with-a-long-random-password
APP_URL=https://data.example.com

# Default Canton Docker Compose conventions.
CANTON_DOCKER_NETWORK=splice-validator_splice_validator
CANTON_SCAN_API_URL=http://validator:5003/api/validator

# LocalNet only: JSON identity array; see docs/docker-compose.md#localnet.
# Leave empty for mainnet, testnet, and devnet.
CANTON_LOCALNET_IDENTITIES=

# Auth0 browser client (leave blank when using Keycloak).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Keycloak browser client (leave blank when using Auth0).
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=

# Database connection tuning. Change one at a time after measuring database load.
DATABASE_MAX_POOL_SIZE=20
DATABASE_CONNECTION_TIMEOUT_SECONDS=15
DATABASE_COMMAND_TIMEOUT_SECONDS=30
# Temporary-file budget per PostgreSQL process, in MiB. Requires backend 4.2.9+.
DATABASE_TEMP_FILE_LIMIT_MB=

# Database storage guard. Set capacity to the actual space allocated to this database.
# Capacity 0 leaves the guard disabled; usage limit is a fraction greater than 0 and at most 1.
# The usage limit requires a Data App release later than 4.2.7; earlier backends ignore it and use 0.85.
DATABASE_VOLUME_CAPACITY=0
DATABASE_VOLUME_USAGE_LIMIT=0.85
