# Use the three pinned image references from the same v4 release.
BACKEND_IMAGE=ghcr.io/noves-inc/noves-canton-backend-v4:4.2.7@sha256:384734c85854cdc09652785f5568267aeef225ea53b66d55a172c93c30742fc6
FRONTEND_IMAGE=ghcr.io/noves-inc/noves-canton-frontend-v4:4.2.7@sha256:dccf44d99c15131906b38286922fb76f041f0eb2a7ac4f92751cfbfb98ea784b
DATABASE_IMAGE=ghcr.io/noves-inc/noves-canton-database-v4:4.2.7@sha256:a22b5cb3a51b72895e2abde952476b46dbcb19b5600300ac2bcc5cd2f66e6082
DATABASE_PASSWORD=replace-with-a-long-random-password
APP_URL=https://data.example.com

# Default Canton Docker Compose conventions.
CANTON_DOCKER_NETWORK=splice-validator_splice_validator
CANTON_SCAN_API_URL=http://validator:5003/api/validator

# Auth0 browser client (leave blank when using Keycloak).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Keycloak browser client (leave blank when using Auth0).
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=

# Database connection tuning. Change one at a time after measuring database load.
DATABASE_MAX_POOL_SIZE=20
DATABASE_CONNECTION_TIMEOUT_SECONDS=15
DATABASE_COMMAND_TIMEOUT_SECONDS=30
