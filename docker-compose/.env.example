# Pin a v4 release for repeatable installs. Set this to latest only when you
# explicitly want the newest v4 image from each v4-only repository.
IMAGE_VERSION=4.0.0
DATABASE_PASSWORD=replace-with-a-long-random-password
APP_URL=https://data.example.com

# The installer writes the installation-specific Noves gateway credential to
# docker-compose/.secrets/noves-gateway-auth-token with mode 0600.

# Default Canton Docker Compose conventions.
CANTON_DOCKER_NETWORK=splice-validator_splice_validator
CANTON_VALIDATOR_URL=http://validator-app:5003
CANTON_PUBLIC_SCAN_URL=
CANTON_NETWORK=mainnet

# Auth0 browser client (leave blank when using Keycloak).
VITE_AUTH0_DOMAIN=tenant.example.auth0.com
VITE_AUTH0_CLIENT_ID=replace-with-spa-client-id
VITE_AUTH0_AUDIENCE=https://canton.network.global

# Keycloak browser client (leave blank when using Auth0).
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=

# Local bindings. Put a TLS reverse proxy in front of the frontend for users.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8091
BACKEND_PORT=8090
SETUP_PORT=8099

# Durable Docker volumes.
DATABASE_VOLUME=noves-canton-data-app-v4-data
EXPORTS_VOLUME=noves-canton-data-app-v4-exports
# Optional absolute path on an encrypted filesystem. Leave blank to use the named volume above.
DATABASE_DATA_PATH=

# Advanced performance tuning. Defaults suit a typical single-node install.
# Increase capacities gradually and observe database CPU, memory, connections, and write latency.
INDEX_DB_WRITE_BATCH_SIZE=250
DATABASE_MAX_PARALLEL_WORKERS_PER_GATHER=0
DATABASE_SYNCHRONOUS_COMMIT=off
DATABASE_MAX_WAL_SIZE=8GB
READ_MODEL_TOTAL_CAPACITY=4
READ_MODEL_RESERVED_LIVE_CAPACITY=1
READ_MODEL_LIVE_WEIGHT=4
READ_MODEL_BOOTSTRAP_WEIGHT=1
READ_MODEL_BOOTSTRAP_BATCH_SIZE=25
# Minimum pause after each non-empty Party Events live batch. Increase to reduce backend CPU bursts.
PARTY_EVENTS_INDEXING_DELAY_MS=0
READ_MODEL_PRESSURE_CHECK_INTERVAL_MS=5000
READ_MODEL_PRESSURE_RESUME_RATIO=0.80
READ_MODEL_CAPTURE_LAG_LIMIT_RECORDS=2000
READ_MODEL_LIVE_WORK_MAX_WAIT_MS=30000
DATABASE_DEAD_TUPLE_RATIO_LIMIT=0.30
DATABASE_DEAD_TUPLE_MINIMUM=1000
DATABASE_TRANSACTION_AGE_LIMIT=100000
PROCESS_MEMORY_LIMIT_BYTES=4294967296
DATABASE_WRITE_IO_UTILIZATION_LIMIT=0.90
DATABASE_CONNECTION_UTILIZATION_LIMIT=0.85
DATABASE_COMMIT_P95_LIMIT_MS=250

# Advanced stream-delivery tuning. Streaming is always part of the backend; it has no sidecar URL.
STREAM_POLL_INTERVAL_MS=5000
STREAM_PAGE_SIZE=100
STREAM_RETRY_DELAY_MS=2000
STREAM_WEBSOCKET_BUFFER_LIMIT=10000
STREAM_DATABASE_TIMEOUT_SECONDS=60
STREAM_DEDUPLICATION_WINDOW_RECORDS=1000000
STREAM_DELIVERY_RECENCY_MINUTES=1440
# Keep false unless callbacks intentionally target services on a private network.
ALLOW_PRIVATE_WEBHOOK_TARGETS=false
