# Use the three pinned image references from the same v4 release.
BACKEND_IMAGE=ghcr.io/noves-inc/noves-canton-backend-v4:4.2.3@sha256:6205ea7931e2cd8a587c87d63384017df2cefbdbbed93d4bd8bbe766c6c79394
FRONTEND_IMAGE=ghcr.io/noves-inc/noves-canton-frontend-v4:4.2.3@sha256:d87f576c154ca7abcdb79d7dc4e892b3a49f20dff8ef44945c6b02df487583ab
DATABASE_IMAGE=ghcr.io/noves-inc/noves-canton-database-v4:4.2.3@sha256:fcf58266db2815a7400ab2236201c67934ee77b280f3933ce3d95fe157e7a543
DATABASE_PASSWORD=replace-with-a-long-random-password
APP_URL=https://data.example.com

# Default Canton Docker Compose conventions.
CANTON_DOCKER_NETWORK=splice-validator_splice_validator
CANTON_SCAN_API_URL=http://validator:5003/api/validator

# Auth0 browser client (leave blank when using Keycloak).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Keycloak browser client (leave blank when using Auth0).
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=
