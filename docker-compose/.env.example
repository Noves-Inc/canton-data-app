# Use the three pinned image references from the same v4 release.
BACKEND_IMAGE=ghcr.io/noves-inc/noves-canton-backend-v4:4.1.3@sha256:08a17924c14c3ef319935e92b159127df93e587c791bfd2ceee50cc47dba2c1c
FRONTEND_IMAGE=ghcr.io/noves-inc/noves-canton-frontend-v4:4.1.3@sha256:8d14cab4c244fafe7cf432d1949f3002bc64993fcc40b810344d55c5ebd7532a
DATABASE_IMAGE=ghcr.io/noves-inc/noves-canton-database-v4:4.1.3@sha256:737f175dcf0a92a25777f5bae3cbaa114a14171c9522f1fcc8333bb6fcdf5248
DATABASE_PASSWORD=replace-with-a-long-random-password
APP_URL=https://data.example.com

# Default Canton Docker Compose conventions.
CANTON_DOCKER_NETWORK=splice-validator_splice_validator
CANTON_SCAN_API_URL=http://validator:5003/api/validator

# Auth0 browser client (leave blank when using Keycloak).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Keycloak browser client (leave blank when using Auth0).
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=

# Optional Data Sharing, awaiting the next release; current validation is DevNet only.
# Leave identifiers empty with the currently pinned release images.
DATA_SHARING_PACKAGE_ID=
DATA_SHARING_SYNCHRONIZER_ID=
DATA_SHARING_MAX_STORED_BYTES=1073741824
