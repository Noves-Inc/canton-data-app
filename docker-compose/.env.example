# Use the three pinned image references from the same v4 release.
BACKEND_IMAGE=ghcr.io/noves-inc/noves-canton-backend-v4:4.1.6@sha256:600cd508dfb94b4c4df994724f8eb558e75e582ca4f254652f09e886e4058c7d
FRONTEND_IMAGE=ghcr.io/noves-inc/noves-canton-frontend-v4:4.1.6@sha256:b0b1a100d05568725f8865a5888aca60817593df4720fb06393aeac6bbeee751
DATABASE_IMAGE=ghcr.io/noves-inc/noves-canton-database-v4:4.1.6@sha256:55556bdf5e8346247100b7cd93f5d523c62503168d15cf6b1661d668e43fe93e
DATABASE_PASSWORD=replace-with-a-long-random-password
APP_URL=https://data.example.com

# Default Canton Docker Compose conventions.
CANTON_DOCKER_NETWORK=splice-validator_splice_validator
CANTON_SCAN_API_URL=http://validator:5003/api/validator

# Auth0 browser client (leave blank when using Keycloak).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Keycloak browser client (leave blank when using Auth0).
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=
