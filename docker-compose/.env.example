# Use the three pinned image references from the same v4 release.
BACKEND_IMAGE=ghcr.io/noves-inc/noves-canton-backend-v4:4.1.1@sha256:6a3a744f47847551e52cc1601bf8d89149ef6ef03fa03c32df62bf303b6b4a27
FRONTEND_IMAGE=ghcr.io/noves-inc/noves-canton-frontend-v4:4.1.1@sha256:7b72bdeb9c973825b47aa5959474c4ed8c81bb789df0bae96bcf207bf1a0c399
DATABASE_IMAGE=ghcr.io/noves-inc/noves-canton-database-v4:4.1.1@sha256:ee1ea296593cef662e0414cd4bf17061343032f9e135cd026e312e1250a640d2
DATABASE_PASSWORD=replace-with-a-long-random-password
APP_URL=https://data.example.com

# Default Canton Docker Compose conventions.
CANTON_DOCKER_NETWORK=splice-validator_splice_validator
CANTON_SCAN_API_URL=http://validator:5003/api/validator

# Auth0 browser client (leave blank when using Keycloak).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Keycloak browser client (leave blank when using Auth0).
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=

# Optional semantic-review allowlists: comma-separated full package hashes, never package names.
# Keep historical reviewed hashes across upgrades. Changes require a backend restart.
REVIEWED_TRANSFER_EVENTS_PACKAGE_IDS=
REVIEWED_MODULO_TOKEN_PACKAGE_IDS=
