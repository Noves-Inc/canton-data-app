# Use the three pinned image references from the same v4 release.
BACKEND_IMAGE=ghcr.io/noves-inc/noves-canton-backend-v4:4.2.2@<BACKEND_DIGEST>
FRONTEND_IMAGE=ghcr.io/noves-inc/noves-canton-frontend-v4:4.2.2@<FRONTEND_DIGEST>
DATABASE_IMAGE=ghcr.io/noves-inc/noves-canton-database-v4:4.2.2@<DATABASE_DIGEST>
DATABASE_PASSWORD=replace-with-a-long-random-password
APP_URL=https://data.example.com

# Default Canton Docker Compose conventions.
CANTON_DOCKER_NETWORK=splice-validator_splice_validator
CANTON_SCAN_API_URL=http://validator:5003/api/validator

# Auth0 browser client (leave blank when using Keycloak).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Keycloak browser client (leave blank when using Auth0).
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=
