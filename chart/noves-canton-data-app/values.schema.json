{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "backend": { "$ref": "#/$defs/backendWorkload" },
    "frontend": { "$ref": "#/$defs/workload" },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "podSecurityContext",
        "containerSecurityContext",
        "existingSecret",
        "passwordKey",
        "name",
        "user",
        "persistence",
        "resources"
      ],
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" },
        "existingSecret": { "type": "string" },
        "passwordKey": { "type": "string" },
        "name": { "type": "string" },
        "user": { "type": "string" },
        "persistence": { "$ref": "#/$defs/persistence" },
        "resources": { "type": "object" }
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "persistence", "s3"],
      "properties": {
        "storage": { "enum": ["pvc", "s3"] },
        "persistence": { "$ref": "#/$defs/persistence" },
        "s3": { "$ref": "#/$defs/s3" }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["s3"],
      "properties": {
        "s3": { "$ref": "#/$defs/backupS3" }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenEncryption"],
      "properties": {
        "tokenEncryption": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "key"],
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "canton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "participantAddress", "network"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "participantAddress": { "type": "string", "minLength": 1 },
        "expectedParticipantId": { "type": "string" },
        "validatorParty": { "type": "string" },
        "synchronizerAlias": { "type": "string" },
        "expectedSynchronizerId": { "type": "string" },
        "certificateSecret": { "type": "string" },
        "certificateKey": { "type": "string" },
        "validatorUrl": { "type": "string" },
        "publicScanUrl": { "type": "string" },
        "network": { "enum": ["mainnet", "testnet", "devnet"] }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "ledgerApiUserKey",
        "tokenEndpointKey",
        "clientIdKey",
        "clientSecretKey",
        "audienceKey",
        "scopeKey"
      ],
      "properties": {
        "existingSecret": { "type": "string" },
        "ledgerApiUserKey": { "type": "string", "minLength": 1 },
        "tokenEndpointKey": { "type": "string", "minLength": 1 },
        "clientIdKey": { "type": "string", "minLength": 1 },
        "clientSecretKey": { "type": "string", "minLength": 1 },
        "audienceKey": { "type": "string", "minLength": 1 },
        "scopeKey": { "type": "string", "minLength": 1 }
      }
    },
    "novesGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "tokenKey"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "tokenKey": { "type": "string", "minLength": 1 }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "appUrl", "auth0", "keycloak"],
      "properties": {
        "provider": { "enum": ["", "auth0", "keycloak"] },
        "appUrl": { "type": "string" },
        "auth0": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "clientId", "audience"],
          "properties": {
            "domain": { "type": "string" },
            "clientId": { "type": "string" },
            "audience": { "type": "string" }
          }
        },
        "keycloak": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "realm", "clientId"],
          "properties": {
            "url": { "type": "string" },
            "realm": { "type": "string" },
            "clientId": { "type": "string" }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "host", "tlsSecret", "annotations", "istio", "ingress"],
      "properties": {
        "provider": { "enum": ["none", "ingress", "istio"] },
        "host": { "type": "string" },
        "tlsSecret": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "istio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gateway"],
          "properties": {
            "gateway": { "type": "string" }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["className"],
          "properties": {
            "className": { "type": "string" }
          }
        }
      }
    },
    "setupWizard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "setupTokenSecret", "setupTokenKey", "sessionTokenKey", "localPort"],
      "properties": {
        "enabled": { "type": "boolean" },
        "setupTokenSecret": { "type": "string" },
        "setupTokenKey": { "type": "string" },
        "sessionTokenKey": { "type": "string" },
        "localPort": { "type": "integer", "minimum": 1024, "maximum": 65535 }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "sourceVersion", "backupConfirmed", "oldWorkloadStopped", "existingClaim"],
      "properties": {
        "enabled": { "type": "boolean" },
        "sourceVersion": { "type": "string" },
        "backupConfirmed": { "type": "boolean" },
        "oldWorkloadStopped": { "type": "boolean" },
        "existingClaim": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database"],
      "properties": {
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  },
  "required": [
    "backend",
    "frontend",
    "database",
    "exports",
    "backup",
    "accounting",
    "canton",
    "capture",
    "novesGateway",
    "oidc",
    "routing",
    "setupWizard",
    "migration",
    "networkPolicy"
  ],
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^(?:|sha256:[0-9a-f]{64})$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "image", "podSecurityContext", "containerSecurityContext", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/$defs/image" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" },
        "resources": { "type": "object" }
      }
    },
    "backendWorkload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "publicApiUrl",
        "image",
        "podSecurityContext",
        "containerSecurityContext",
        "extraEnv",
        "resources",
        "performance",
        "streaming"
      ],
      "properties": {
        "replicaCount": { "type": "integer", "const": 1 },
        "publicApiUrl": { "type": "string", "format": "uri", "pattern": "^(?:[Hh][Tt][Tt][Pp][Ss]://(?:\\[[0-9A-Fa-f:.]+\\]|[^\\s/:?#]+)(?::(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\s]*)?|[Hh][Tt][Tt][Pp]://(?:[Ll][Oo][Cc][Aa][Ll][Hh][Oo][Ss][Tt]|127(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|\\[::1\\])(?::(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\s]*)?)$", "description": "Public Noves API base URL used by the backend. HTTPS is required except for loopback HTTP." },
        "image": { "$ref": "#/$defs/image" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" },
        "extraEnv": { "type": "array", "items": { "type": "object" } },
        "resources": { "type": "object" },
        "performance": { "$ref": "#/$defs/performance" },
        "streaming": { "$ref": "#/$defs/streaming" }
      }
    },
    "streaming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pollIntervalMs",
        "pageSize",
        "retryDelayMs",
        "websocketBufferLimit",
        "databaseTimeoutSeconds",
        "deduplicationWindowRecords",
        "deliveryRecencyMinutes",
        "allowPrivateWebhookTargets"
      ],
      "properties": {
        "pollIntervalMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "retryDelayMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
        "websocketBufferLimit": { "type": "integer", "minimum": 100, "maximum": 100000 },
        "databaseTimeoutSeconds": { "type": "integer", "minimum": 5, "maximum": 600 },
        "deduplicationWindowRecords": { "type": "integer", "minimum": 1000, "maximum": 100000000 },
        "deliveryRecencyMinutes": { "type": "integer", "minimum": 0, "maximum": 525600 },
        "allowPrivateWebhookTargets": { "type": "boolean" }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "readModel"],
      "properties": {
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "writeBatchSize",
            "maxParallelWorkersPerGather",
            "synchronousCommit",
            "maxWalSize",
            "deadTupleRatioLimit",
            "deadTupleMinimum",
            "transactionAgeLimit",
            "writeIoUtilizationLimit",
            "connectionUtilizationLimit",
            "commitP95LimitMs"
          ],
          "properties": {
            "writeBatchSize": { "type": "integer", "minimum": 1, "maximum": 250 },
            "maxParallelWorkersPerGather": { "type": "integer", "minimum": 0 },
            "synchronousCommit": { "enum": ["off", "on", "local", "remote_write", "remote_apply"] },
            "maxWalSize": { "type": "string", "minLength": 1 },
            "deadTupleRatioLimit": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "deadTupleMinimum": { "type": "integer", "minimum": 1 },
            "transactionAgeLimit": { "type": "integer", "minimum": 1 },
            "writeIoUtilizationLimit": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "connectionUtilizationLimit": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "commitP95LimitMs": { "type": "integer", "minimum": 1 }
          }
        },
        "readModel": {
          "type": "object",
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "backgroundIndexingDutyPercent": { "maximum": 99 }
                }
              },
              "then": {
                "properties": {
                  "partyEventsIndexingDelayMs": { "const": 0 }
                }
              }
            }
          ],
          "required": [
            "totalCapacity",
            "reservedLiveCapacity",
            "liveWeight",
            "bootstrapWeight",
            "bootstrapBatchSize",
            "backgroundIndexingDutyPercent",
            "partyEventsIndexingDelayMs",
            "pressureCheckIntervalMs",
            "pressureResumeRatio",
            "captureLagLimitRecords",
            "liveWorkMaxWaitMs",
            "processMemoryLimitBytes"
          ],
          "properties": {
            "totalCapacity": { "type": "integer", "minimum": 1 },
            "reservedLiveCapacity": { "type": "integer", "minimum": 1 },
            "liveWeight": { "type": "integer", "minimum": 1 },
            "bootstrapWeight": { "type": "integer", "minimum": 1 },
            "bootstrapBatchSize": { "type": "integer", "minimum": 1 },
            "backgroundIndexingDutyPercent": { "type": "integer", "minimum": 1, "maximum": 100 },
            "partyEventsIndexingDelayMs": { "type": "integer", "minimum": 0 },
            "pressureCheckIntervalMs": { "type": "integer", "minimum": 1 },
            "pressureResumeRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "captureLagLimitRecords": { "type": "integer", "minimum": 1 },
            "liveWorkMaxWaitMs": { "type": "integer", "minimum": 1 },
            "processMemoryLimitBytes": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "storageClass"],
      "properties": {
        "existingClaim": { "type": "string" },
        "size": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" }
      }
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket",
        "endpointUrl",
        "region",
        "existingSecret",
        "accessKeyIdKey",
        "secretAccessKeyKey",
        "sessionTokenKey"
      ],
      "properties": {
        "bucket": { "type": "string" },
        "endpointUrl": { "type": "string" },
        "region": { "type": "string" },
        "existingSecret": { "type": "string" },
        "accessKeyIdKey": { "type": "string", "minLength": 1 },
        "secretAccessKeyKey": { "type": "string", "minLength": 1 },
        "sessionTokenKey": { "type": "string", "minLength": 1 }
      }
    },
    "backupS3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "bucket",
        "endpointUrl",
        "region",
        "existingSecret",
        "accessKeyIdKey",
        "secretAccessKeyKey",
        "sessionTokenKey"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "bucket": { "type": "string" },
        "endpointUrl": { "type": "string" },
        "region": { "type": "string" },
        "existingSecret": { "type": "string" },
        "accessKeyIdKey": { "type": "string", "minLength": 1 },
        "secretAccessKeyKey": { "type": "string", "minLength": 1 },
        "sessionTokenKey": { "type": "string", "minLength": 1 }
      }
    }
  }
}
