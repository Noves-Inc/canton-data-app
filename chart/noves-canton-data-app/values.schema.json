{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "backend": { "$ref": "#/$defs/backendWorkload" },
    "frontend": { "$ref": "#/$defs/workload" },
    "embedded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedOrigins"],
      "properties": {
        "allowedOrigins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://(?:\\[[0-9A-Fa-f:.]+\\]|[^/?#\\s:*@]+)(?::[0-9]{1,5})?$"
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "podSecurityContext",
        "containerSecurityContext",
        "existingSecret",
        "passwordKey",
        "name",
        "user",
        "persistence",
        "resources"
      ],
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" },
        "existingSecret": { "type": "string" },
        "passwordKey": { "type": "string" },
        "name": { "type": "string" },
        "user": { "type": "string" },
        "persistence": { "$ref": "#/$defs/persistence" },
        "resources": { "type": "object" }
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "persistence", "s3"],
      "properties": {
        "storage": { "enum": ["pvc", "s3"] },
        "persistence": { "$ref": "#/$defs/persistence" },
        "s3": { "$ref": "#/$defs/s3" }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["s3"],
      "properties": {
        "s3": { "$ref": "#/$defs/backupS3" }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenEncryption"],
      "properties": {
        "tokenEncryption": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "key"],
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "canton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanApiUrl", "nodes"],
      "properties": {
        "scanApiUrl": { "type": "string" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cantonNode" }
        }
      }
    },
    "m2mIndexing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "ledgerApiUserKey",
        "tokenEndpointKey",
        "clientIdKey",
        "clientSecretKey",
        "audienceKey",
        "scopeKey"
      ],
      "properties": {
        "existingSecret": { "type": "string" },
        "ledgerApiUserKey": { "type": "string", "minLength": 1 },
        "tokenEndpointKey": { "type": "string", "minLength": 1 },
        "clientIdKey": { "type": "string", "minLength": 1 },
        "clientSecretKey": { "type": "string", "minLength": 1 },
        "audienceKey": { "type": "string", "minLength": 1 },
        "scopeKey": { "type": "string", "minLength": 1 }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "appUrl", "auth0", "keycloak"],
      "properties": {
        "provider": { "enum": ["", "auth0", "keycloak"] },
        "appUrl": { "type": "string" },
        "auth0": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "clientId", "audience"],
          "properties": {
            "domain": { "type": "string" },
            "clientId": { "type": "string" },
            "audience": { "type": "string" }
          }
        },
        "keycloak": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "realm", "clientId"],
          "properties": {
            "url": { "type": "string" },
            "realm": { "type": "string" },
            "clientId": { "type": "string" }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "host", "tlsSecret", "annotations", "backend", "istio", "ingress"],
      "properties": {
        "provider": { "enum": ["none", "ingress", "istio"] },
        "host": { "type": "string" },
        "tlsSecret": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "host", "tlsSecret"],
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string" },
            "tlsSecret": { "type": "string" }
          }
        },
        "istio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gateway"],
          "properties": {
            "gateway": { "type": "string" }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["className"],
          "properties": {
            "className": { "type": "string" }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "sourceVersion", "backupConfirmed", "oldWorkloadStopped", "existingClaim"],
      "properties": {
        "enabled": { "type": "boolean" },
        "sourceVersion": { "type": "string" },
        "backupConfirmed": { "type": "boolean" },
        "oldWorkloadStopped": { "type": "boolean" },
        "existingClaim": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database"],
      "properties": {
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  },
  "required": [
    "backend",
    "frontend",
    "embedded",
    "database",
    "exports",
    "backup",
    "accounting",
    "canton",
    "m2mIndexing",
    "oidc",
    "routing",
    "migration",
    "networkPolicy"
  ],
  "$defs": {
    "cantonNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "addr", "tls", "m2mIndexing"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$" },
        "addr": { "type": "string", "minLength": 1 },
        "validatorParty": { "type": "string" },
        "synchronizerAlias": { "type": "string" },
        "tls": { "$ref": "#/$defs/cantonTls" },
        "m2mIndexing": { "$ref": "#/$defs/nodeM2mIndexing" }
      }
    },
    "cantonTls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "certificateKey": { "type": "string" },
        "clientCertificateKey": { "type": "string" },
        "clientPrivateKeyKey": { "type": "string" },
        "serverName": { "type": "string" }
      }
    },
    "nodeM2mIndexing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["global", "clientCredentials", "staticToken"] },
        "tokenEndpoint": { "type": "string" },
        "clientId": { "type": "string" },
        "audience": { "type": "string" },
        "scope": { "type": "string" },
        "existingSecret": { "type": "string" },
        "clientSecretKey": { "type": "string", "minLength": 1 },
        "staticTokenKey": { "type": "string", "minLength": 1 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^(?:|sha256:[0-9a-f]{64})$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "image", "podSecurityContext", "containerSecurityContext", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/$defs/image" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" },
        "resources": { "type": "object" }
      }
    },
    "backendWorkload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "image",
        "podSecurityContext",
        "containerSecurityContext",
        "extraEnv",
        "performance",
        "streaming",
        "allowPrivateWebhookTargets",
        "resources"
      ],
      "properties": {
        "replicaCount": { "type": "integer", "const": 1 },
        "image": { "$ref": "#/$defs/image" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" },
        "extraEnv": { "type": "array", "items": { "type": "object" } },
        "performance": { "$ref": "#/$defs/backendPerformance" },
        "streaming": { "$ref": "#/$defs/streaming" },
        "allowPrivateWebhookTargets": { "type": "boolean" },
        "resources": { "type": "object" }
      }
    },
    "backendPerformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "readModel"],
      "properties": {
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["writeBatchSize", "maxParallelWorkersPerGather", "synchronousCommit"],
          "properties": {
            "writeBatchSize": { "type": "integer", "minimum": 1, "maximum": 250 },
            "maxParallelWorkersPerGather": { "type": "integer", "minimum": 0 },
            "synchronousCommit": {
              "enum": ["off", "on", "local", "remote_write", "remote_apply"]
            }
          }
        },
        "readModel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["totalCapacity", "reservedLiveCapacity", "backgroundIndexingDutyPercent"],
          "properties": {
            "totalCapacity": { "type": "integer", "minimum": 2 },
            "reservedLiveCapacity": { "type": "integer", "minimum": 1 },
            "backgroundIndexingDutyPercent": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        }
      }
    },
    "streaming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pollIntervalMs",
        "pageSize",
        "retryDelayMs",
        "websocketBufferLimit",
        "databaseTimeoutSeconds",
        "deduplicationWindowRecords",
        "deliveryRecencyMinutes"
      ],
      "properties": {
        "pollIntervalMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "retryDelayMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
        "websocketBufferLimit": { "type": "integer", "minimum": 100, "maximum": 100000 },
        "databaseTimeoutSeconds": { "type": "integer", "minimum": 5, "maximum": 600 },
        "deduplicationWindowRecords": { "type": "integer", "minimum": 1000, "maximum": 100000000 },
        "deliveryRecencyMinutes": { "type": "integer", "minimum": 0, "maximum": 525600 }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "storageClass"],
      "properties": {
        "existingClaim": { "type": "string" },
        "size": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" }
      }
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket",
        "endpointUrl",
        "region",
        "existingSecret",
        "accessKeyIdKey",
        "secretAccessKeyKey",
        "sessionTokenKey"
      ],
      "properties": {
        "bucket": { "type": "string" },
        "endpointUrl": { "type": "string" },
        "region": { "type": "string" },
        "existingSecret": { "type": "string" },
        "accessKeyIdKey": { "type": "string", "minLength": 1 },
        "secretAccessKeyKey": { "type": "string", "minLength": 1 },
        "sessionTokenKey": { "type": "string", "minLength": 1 }
      }
    },
    "backupS3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "bucket",
        "endpointUrl",
        "region",
        "existingSecret",
        "accessKeyIdKey",
        "secretAccessKeyKey",
        "sessionTokenKey"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "bucket": { "type": "string" },
        "endpointUrl": { "type": "string" },
        "region": { "type": "string" },
        "existingSecret": { "type": "string" },
        "accessKeyIdKey": { "type": "string", "minLength": 1 },
        "secretAccessKeyKey": { "type": "string", "minLength": 1 },
        "sessionTokenKey": { "type": "string", "minLength": 1 }
      }
    }
  }
}
